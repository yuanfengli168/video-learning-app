# iOS PocketMVP — local-only files (NOT tracked in git)

# ─── Firebase config ─────────────────────────────────────────────────────────
# The GoogleService-Info.plist contains:
#   - API_KEY (server-side restricted, but still sensitive)
#   - CLIENT_ID / REVERSED_CLIENT_ID (OAuth identifiers)
#   - GOOGLE_APP_ID (project + platform identifier)
#   - PROJECT_ID + STORAGE_BUCKET
#
# Per Firebase's own guidance for open-source repos, we DON'T commit
# this file. Each developer downloads it from Firebase Console:
#   1. Open https://console.firebase.google.com/project/video-learning-app-3cf41
#   2. ⚙️ Project Settings → General → Your apps → PocketMVP iOS
#   3. Download GoogleService-Info.plist
#   4. Drop it into ios/PocketMVP/Resources/GoogleService-Info.plist
#   5. Flip FirebaseAppConfig.skipConfigure = false (see Swift file)
#
# To completely remove a previously-committed copy from git history,
# run (one-time, on a fresh clone, before pushing):
#   git rm --cached ios/PocketMVP/Resources/GoogleService-Info.plist
#   git commit -m "stop tracking iOS Firebase plist (open-source repo)"
Resources/GoogleService-Info.plist
Resources/GoogleService-Info.plist.bak

# ─── Xcode-generated / per-user ──────────────────────────────────────────────
# build/ is already in the repo-root .gitignore but listing it here too
# keeps the iOS folder self-contained.
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# SPM package resolved sources (regenerated by `xcodegen generate`)
SourcePackages/
.build/

# macOS noise
.DS_Store
