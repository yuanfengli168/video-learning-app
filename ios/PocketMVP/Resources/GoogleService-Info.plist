<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        GoogleService-Info.plist for PocketMVP (iOS).

        This file is generated by the user from the Firebase Console →
        Project Settings → Your apps → iOS app → "Download GoogleService-Info.plist".
        For now we've hand-rolled the values that match the web Firebase
        config (.env). When we register the iOS app properly in the Firebase
        Console, Firebase will give us a more complete file with iOS-specific
        client IDs and reversed URL schemes.

        v0.1.3-real-teaching v0.2 (Firebase auth on iOS):
        - The values below let FirebaseAuth work for email/password sign-in.
        - Google sign-in will NOT work until we register the iOS app in
          Firebase Console and replace the placeholder values with the
          real iOS client IDs.
    -->

    <!-- API key shared with the web app (matches FIREBASE_API_KEY in .env). -->
    <key>API_KEY</key>
    <string>AIzaSyCqpLEiyZ91--uv5SQZfH091aNdLt33dxk</string>

    <!-- The Firebase project (matches FIREBASE_PROJECT_ID in .env). -->
    <key>PROJECT_ID</key>
    <string>video-learning-app-3cf41</string>

    <!--
        Storage bucket. Matches FIREBASE_STORAGE_BUCKET in .env.
        v0.2: Pocket doesn't use Storage yet — only here because Firebase
        iOS SDK expects every field from the web config.
    -->
    <key>STORAGE_BUCKET</key>
    <string>video-learning-app-3cf41.firebasestorage.app</string>

    <!--
        Google App ID. v0.2: real value comes from the iOS app registration
        in Firebase Console. The current value is the web app ID — Firebase
        Auth will still work for email/password but Google sign-in will
        fail at the OAuth redirect step until this is replaced.
    -->
    <key>GOOGLE_APP_ID</key>
    <string>1:637126854377:web:1ddb490a8e9dbe8690d278</string>

    <!--
        iOS bundle ID. Must match PRODUCT_BUNDLE_IDENTIFIER in project.yml
        so the OAuth callback URL is registered against the right app.
    -->
    <key>BUNDLE_ID</key>
    <string>com.shoothigh.pocketmvp</string>

    <!--
        NOTE on missing fields: Firebase iOS SDK doesn't require client_id
        for Auth operations (only for Google Sign-In OAuth). The real iOS
        client IDs (CLIENT_ID, REVERSED_CLIENT_ID) come from registering
        the iOS app in Firebase Console. We add them when we wire up
        Google sign-in (v0.2 follow-up).
    -->
</dict>
</plist>