<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.videoapp.backup-probe</string>

    <!--
      TEMPLATE — do not load this file directly. The path below is the
      repo-local default for development; on a prod host it must be
      patched to the TCC-clean runtime path. Run scripts/setup-probe.sh
      (or scripts/setup-backups.sh for the other 4 plists) to install.

      Why the runtime path matters:
        macOS launchd runs scripts under user context. If the script path is
        under ~/Desktop/, the kernel returns EPERM ("Operation not permitted",
        exit 126). We avoid that by always running scripts from
        ~/Library/Application Support/ which is not TCC-restricted for bash
        exec. See Prod-Must-do.md for the full explanation.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jackyli/Desktop/Githubs/video-learning-app/scripts/backup/backup-probe.sh</string>
    </array>

    <!-- Every 5 minutes. Cheap probe (single launchctl print per
         job + one diskutil + a few stat calls). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/jackyli/Library/Logs/video-app-backup.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jackyli/Library/Logs/video-app-backup.log</string>

    <!-- Run once immediately on launchctl load, then every 5 min. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- If the previous probe is still running (extremely unlikely),
         don't start another. Keeps the log sane. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
