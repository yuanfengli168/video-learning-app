# ── App ──
APP_NAME=Video Learning App
DEBUG=true
# Cookie Secure flag — flip to true when serving HTTPS via the
# Cloudflare Tunnel in production (browsers refuse Secure cookies
# over plain http://localhost, keep false for local dev).
COOKIE_SECURE=false

# ── Database ──
# MVP2: DB lives on Storage-Fast-NVMe (Samsung 990 Pro 1TB) for IOPS
# For local dev without external drives, use: sqlite:///./video_learning.db
DATABASE_URL=sqlite:////Volumes/Storage-Fast-NVMe/video_learning.db

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
# Model-choice caveat (2026-09-09, live-tested):
#   glm-5.2:cloud is the VALIDATED model — all 1370+ tests and every
#   real generated asset (summary/mindmap/flashcards/quiz) were
#   produced + validated with it. The generation pipeline asks for
#   strictly-structured JSON/markdown and its parser does NOT handle
#   thinking-model output.
#   minimax-m3:cloud is installed and works, BUT it is a THINKING
#   model — it emits a "Thinking…" block before its answer, which
#   risks (a) JSON parse failures → videos land in status='error',
#   (b) different markdown structure for mindmaps/flashcards.
#   If you want to switch: A/B test 2-3 videos first (generate with
#   glm, delete assets, regenerate, compare), and verify the JSON
#   parser handles its raw output. One-line change + restart —
#   but NOT a safe pre-launch switch.
OLLAMA_MODEL=glm-5.2:cloud

# ── Firebase (AuthKit frontend + Admin SDK backend) ──
# Get these from Firebase Console → Project Settings → Web App
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK — generate a service account key JSON from
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Place the JSON file somewhere safe and point to it here:
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# ── Storage ──
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage